    "content": "\\about\n-- HOSPITAL PATIENT DATA ANALYSIS\n-- Synthetic dataset: 1,000 patient records\n-- Tools: MySQL + Power BI\n-- Purpose: Exploratory analysis of hospital patient data\n\nCREATE DATABASE IF NOT EXISTS hospital_analysis;\nUSE hospital_analysis;\nCREATE TABLE IF NOT EXISTS patients (\n    patient_id INT PRIMARY KEY,\n    age INT,\n    gender VARCHAR(10),\n    diagnosis VARCHAR(50),\n    department VARCHAR(50),\n    admission_date DATE,\n    discharge_date DATE,\n    length_of_stay INT,\n    admission_type VARCHAR(20),\n    treatment_type VARCHAR(50),\n    outcome VARCHAR(30)\n);LOAD DATA INFILE 'C:/ProgramData/MySQL/MySQL Server 8.0/Uploads/hospital_patient_data.csv'\nINTO TABLE patients\nFIELDS TERMINATED BY ','\nENCLOSED BY '\"'\nLINES TERMINATED BY '\\n'\nIGNORE 1 ROWS;\n-- 1. Check total number of patients\nSELECT COUNT(*) AS total_patients\nFROM patients;\n\n-- 2. Check for duplicate patient IDs\nSELECT patient_id, COUNT(*) AS count\nFROM patients\nGROUP BY patient_id\nHAVING COUNT(*) > 1;\n\n-- 3. Check for missing values\nSELECT\n    SUM(patient_id IS NULL) AS missing_patient_id,\n    SUM(age IS NULL) AS missing_age,\n    SUM(gender IS NULL) AS missing_gender,\n    SUM(diagnosis IS NULL) AS missing_diagnosis,\n    SUM(department IS NULL) AS missing_department,\n    SUM(admission_date IS NULL) AS missing_admission_date,\n    SUM(discharge_date IS NULL) AS missing_discharge_date,\n    SUM(length_of_stay IS NULL) AS missing_length_of_stay,\n    SUM(admission_type IS NULL) AS missing_admission_type,\n    SUM(treatment_type IS NULL) AS missing_treatment_type,\n    SUM(outcome IS NULL) AS missing_outcome\nFROM patients;\n\n-- 4. Check age range\nSELECT\n    MIN(age) AS minimum_age,\n    MAX(age) AS maximum_age,\n    AVG(age) AS average_age\nFROM patients;\n\n-- 5. Check length-of-stay range\nSELECT\n    MIN(length_of_stay) AS minimum_los,\n    MAX(length_of_stay) AS maximum_los,\n    AVG(length_of_stay) AS average_los\nFROM patients;\n\n-- 6. Check length-of-stay consistency\nSELECT *\nFROM patients\nWHERE length_of_stay <> DATEDIFF(discharge_date, admission_date);\n-- =====================================================\n--  ANALYSIS QUERIES\n-- =====================================================\n\n-- 1. Diagnosis distribution\nSELECT\n    diagnosis,\n    COUNT(*) AS patient_count\nFROM patients\nGROUP BY diagnosis\nORDER BY patient_count DESC;\n\n\n-- 2. Patient volume by department\nSELECT\n    department,\n    COUNT(*) AS patient_count\nFROM patients\nGROUP BY department\nORDER BY patient_count DESC;\n\n\n-- 3. Patient distribution by age group\nSELECT\n    CASE\n        WHEN age < 18 THEN 'Child'\n        WHEN age BETWEEN 18 AND 39 THEN 'Young Adult'\n        WHEN age BETWEEN 40 AND 59 THEN 'Middle-Aged Adult'\n        ELSE 'Older Adult'\n    END AS age_group,\n    COUNT(*) AS patient_count\nFROM patients\nGROUP BY age_group\nORDER BY patient_count DESC;\n\n\n-- 4. Gender distribution\nSELECT\n    gender,\n    COUNT(*) AS patient_count\nFROM patients\nGROUP BY gender\nORDER BY patient_count DESC;\n\n\n-- 5. Admission type distribution\nSELECT\n    admission_type,\n    COUNT(*) AS patient_count\nFROM patients\nGROUP BY admission_type\nORDER BY patient_count DESC;\n\n\n-- 6. Treatment type distribution\nSELECT\n    treatment_type,\n    COUNT(*) AS patient_count\nFROM patients\nGROUP BY treatment_type\nORDER BY patient_count DESC;\n\n\n-- 7. Patient outcomes\nSELECT\n    outcome,\n    COUNT(*) AS patient_count\nFROM patients\nGROUP BY outcome\nORDER BY patient_count DESC;\n\n\n-- 8. Average length of stay by department\nSELECT\n    department,\n    COUNT(*) AS patient_count,\n    ROUND(AVG(length_of_stay), 2) AS average_los\nFROM patients\nGROUP BY department\nORDER BY average_los DESC;\n\n\n-- 9. Average length of stay by diagnosis\nSELECT\n    diagnosis,\n    COUNT(*) AS patient_count,\n    ROUND(AVG(length_of_stay), 2) AS average_los\nFROM patients\nGROUP BY diagnosis\nORDER BY average_los DESC;\n\n\n-- 10. Monthly admission trends\nSELECT\n    YEAR(admission_date) AS admission_year,\n    MONTH(admission_date) AS admission_month,\n    DATE_FORMAT(admission_date, '%Y-%m') AS admission_month_label,\n    COUNT(*) AS patient_count\nFROM patients\nGROUP BY\n    YEAR(admission_date),\n    MONTH(admission_date),\n    DATE_FORMAT(admission_date, '%Y-%m')\nORDER BY\n    admission_year,\n    admission_month;\n\n\n-- 11. Outcomes by admission type\nSELECT\n    admission_type,\n    outcome,\n    COUNT(*) AS patient_count\nFROM patients\nGROUP BY admission_type, outcome\nORDER BY admission_type, patient_count DESC;\n\n\n-- 12. Overall healthcare KPIs\nSELECT\n    COUNT(*) AS total_patients,\n    ROUND(AVG(age), 2) AS average_age,\n    ROUND(AVG(length_of_stay), 2) AS average_los,\n    SUM(outcome = 'Discharged') AS discharged_patients\nFROM patients;\n\n\n-- 13. Discharge rate\nSELECT\n    ROUND(\n        100 * SUM(outcome = 'Discharged') / COUNT(*),\n        2\n    ) AS discharge_rate_percent\nFROM patients;\nSELECT\n    ROUND(\n        100 * SUM(outcome = 'Discharged') / COUNT(*),\n        2\n    ) AS discharge_rate_percent\nFROM patients;\n\n\n\n\n\n",
